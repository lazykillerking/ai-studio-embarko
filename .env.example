# Directory for persistent SQLite storage (provided automatically by Embarko)
DATA_DIR="./data"

# HTTP port to listen on (provided automatically by Embarko; default 3000 locally)
PORT=3000

# Public base URL for absolute OpenGraph link-preview tags and share links
APP_URL="http://localhost:3000"

# Set to "true" to pin each pack's first 7 published questions daily during launch/judging
LAUNCH_SET_MODE="false"
